# CENTRE DE NOUVELLES — server-side only. Never expose these to the browser.
# Copy to .env and fill in. Do not commit .env.

TZ=America/Montreal
PORT=3000
HOSTNAME=0.0.0.0

# SQLite directory (mounted as a volume in Docker)
DATA_DIR=./data

# Admin login. Password is hashed on boot and never stored in plaintext.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# HMAC secret for signed session cookies (long random string)
SESSION_SECRET=

# Cboe requires no environment variable or API key. It supplies free delayed
# US equity/FNB quotes. Twelve Data is optional for selected non-Cboe symbols.
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=
# Conservative Twelve Data guardrails: at most 6 symbols every 30 minutes.
# This reduces credit use but does not add international rights to the free plan.
TWELVE_DATA_REFRESH_MINUTES=30
TWELVE_DATA_MAX_SYMBOLS=6

# hybrid (Cboe per US symbol + Twelve Data only where selected) is recommended.
# Also supported: cboe | bankofcanada | finnhub | twelvedata
MARKETS_PROVIDER=hybrid

# Home Assistant REST connector (optional). Create a dedicated long-lived token
# in Home Assistant and keep it only in this private environment file.
HA_BASE_URL=
HA_TOKEN=
HA_SYNC_INTERVAL_SECONDS=300
ACTIVITY_PULSE_ENABLED=0

# Comma-separated extra allowed origins for admin CSRF (optional)
# ADMIN_ORIGINS=http://192.168.1.10:3000

# Cisco RoomOS local configuration (used by setup and the protected /remote).
# NEWSROOM_URL must be the Docker host LAN URL reachable from the Board.
ROOMOS_DEVICE_IP=192.168.10.245
ROOMOS_USERNAME=localadmin
ROOMOS_PASSWORD=
ROOMOS_PROTOCOL=https
ROOMOS_INSECURE_TLS=0
ROOMOS_APPLY=0
NEWSROOM_URL=
